# ═══════════════════════════════════════════════
#  VELOX — Variables de entorno
#  Copiar como .env.local y completar los valores
#  NUNCA subir .env.local al repositorio
# ═══════════════════════════════════════════════

# ── Supabase (obligatorio) ───────────────────────
# Encontrás estos valores en: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Solo para operaciones server-side (API routes)
# No exponer en frontend
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── IA - Fase 2 (opcional, activa Claude API) ────
# Sin esta variable, el asistente usa respuestas por reglas
# Conseguir en: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# ── IA - Fase 3 (futuro) ─────────────────────────
# Transcripción de audio con Whisper
# OPENAI_API_KEY=sk-...

# Respuestas de voz con ElevenLabs
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=...
