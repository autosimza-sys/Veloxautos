# Public configuration for an explicitly authorized Supabase project.
# Copy to .env.local for local staging; .env.local is excluded from Git.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Use only the project's public client key. NEVER put service_role, database
# passwords or other private credentials in any NEXT_PUBLIC_* variable.
# Backend-only AI configuration. Disabled until approved provider/budget and staged SQL are verified.
# SUPABASE_SERVICE_ROLE_KEY=
# ANTHROPIC_API_KEY=
# VELOX_AI_ENABLED=false
# VELOX_AI_MODEL=
# VELOX_AI_DAILY_USER_LIMIT=
# VELOX_AI_DAILY_GLOBAL_LIMIT=
