# Public configuration for an explicitly authorized Supabase project.
# Copy to .env.local for local staging; .env.local is excluded from Git.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Use only the project's public client key. NEVER put service_role, database
# passwords or other private credentials in any NEXT_PUBLIC_* variable.
# Backend-only AI configuration. Disabled until approved provider/budget and staged SQL are verified.
# SUPABASE_SERVICE_ROLE_KEY=
# ANTHROPIC_API_KEY=
# VELOX_AI_ENABLED=false
# VELOX_AI_PROVIDER=vercel
# VELOX_AI_MODEL=anthropic/claude-haiku-4.5
# Vercel uses its request-time OIDC identity; no external provider key required.
# AI_GATEWAY_API_KEY=
# Direct alternative: VELOX_AI_PROVIDER=anthropic
# VELOX_AI_MODEL=claude-haiku-4-5-20251001
# VELOX_AI_MONTHLY_BUDGET_USD=10
# VELOX_AI_DAILY_USER_LIMIT=5
# VELOX_AI_DAILY_GLOBAL_LIMIT=30
# Apply 202610100001_ai_monthly_budget before activation. Reservations are
# conservative, not actual invoices. Reviewed model prices expire 2026-11-10.
